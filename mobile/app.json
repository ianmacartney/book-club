{
  "expo": {
    "name": "Push Up Club",
    "slug": "push-up-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "pushupclub",
    "backgroundColor": "#F4EFE5",
    "platforms": ["ios"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pushupclub.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pushupclub.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4EFE5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#8A3B2A"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "convexUrl": "https://secret-barracuda-975.convex.cloud",
      "eas": {
        "projectId": "c6fb0140-1e57-48f1-841b-417c01e3cecf"
      }
    },
    "owner": "ianatconvex",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c6fb0140-1e57-48f1-841b-417c01e3cecf"
    }
  }
}
