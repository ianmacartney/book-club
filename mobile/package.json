{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@convex-dev/auth": "https://pkg.pr.new/@convex-dev/auth@348fb3a",
    "@expo/vector-icons": "^15.0.2",
    "convex": "^1.42.3",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-notifications": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.10",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",

    "dev": "expo start --dev-client",
    "device": "expo run:ios --device",

    "typecheck": "tsc --noEmit",
    "verify:deps": "node scripts/verify-deps.mjs",
    "verify:bundle": "expo export --platform all --output-dir /tmp/pushupclub-verify-bundle && rm -rf /tmp/pushupclub-verify-bundle",
    "verify:eas": "bash scripts/verify-eas-bundle.sh",
    "preflight": "npm run typecheck && npm run verify:deps && npm run verify:bundle && npm run verify:eas",

    "build:ios": "npm run preflight && eas build --platform ios --profile production",
    "build:preview": "npm run preflight && eas build --platform ios --profile preview",
    "submit:ios": "eas submit --platform ios",

    "ota:production": "npm run preflight && eas update --branch production",
    "ota:preview": "npm run preflight && eas update --branch preview",
    "ota:promote": "eas update:republish --branch preview --destination-branch production",
    "ota:rollback": "eas update:roll-back-to-embedded --branch production",

    "builds": "eas build:list --limit 5",
    "build:why": "bash scripts/build-error.sh"
  },
  "private": true
}
