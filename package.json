{
  "name": "book-club",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p convex",
    "preview": "vite preview",
    "deploy:dev": "convex dev --once && static-hosting upload --build"
  },
  "dependencies": {
    "@convex-dev/auth": "https://pkg.pr.new/@convex-dev/auth@reboot",
    "@convex-dev/expo-push-notifications": "^0.3.1",
    "@convex-dev/static-hosting": "^0.2.0",
    "convex": "^1.42.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "npm-run-all2": "^8.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.0"
  }
}
